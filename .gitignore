__pycache__/
*.pyc
.venv/
.env
.env.local
*.egg-info/
dist/
build/

# Local DB data volume
.pgdata/

# Source debate docs are not redistributed — only the parsed evidence.
# Cards/sources/tags live in db_seed.sql; the .docx/.doc inputs stay local.
Evidence/
parsed_docs/
extracted/
example_card_01.txt

# Editor
.vscode/
.idea/
.claude/

# OS
.DS_Store

# Seed dump regenerations are local backups, not for git. The currently
# committed db_seed.sql is left as-is (small enough to be useful for
# testing / fresh installs of the personal corpus). Full-corpus seeds
# including wiki ingest land outside the repo (per-clone backups via
# pg_dump). `git update-index --skip-worktree db_seed.sql` is also set
# so local regenerations don't show up in git status.
db_seed.sql

# SSH keys for AWS / EC2 deployment (per-developer, never committed).
*.pem
*.key

# Cloudflare origin private key (no extension, slips past *.pem/*.key)
eevn_priv_key
eevn_origin.pem

# Live-host deployment cheat-sheet (IPs, instance IDs, paths). Not
# secret on its own, but no reason to publish the attack surface.
DEPLOYMENT_INFORMATION.md
