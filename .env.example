# Postgres connection. The default below matches docker-compose.yml; only
# override if you move the DB or change the docker port.
DATABASE_URL=postgresql+psycopg://debatabase:debatabase@localhost:5433/debatabase

# Claude API key. Required for "Find evidence that answers this card" on
# card detail (Haiku rewrites the tag as the inverse claim). The button is
# hidden until this is set.
ANTHROPIC_API_KEY=

# Voyage AI key. Required to enable the semantic side of /search and the
# vector lookup behind "answer this card". Without it, /search degrades to
# tsvector-only and the "answer this card" button stays hidden. Run
# scripts/backfill_embeddings.py once after setting this to embed the corpus.
VOYAGE_API_KEY=

# Signing key for the session cookie (auth, FEATURE_ADDITIONS.md #6). If
# unset, the server uses a public dev fallback and prints a warning on
# startup. For local single-user dev this is fine; set it before exposing
# the server beyond localhost. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# Deployment environment. Set to "production" on a deployed instance: the
# server then refuses to start with the dev SESSION_SECRET fallback and
# marks the session cookie Secure (HTTPS-only). Anything else (or unset)
# is dev mode.
DEBATABASE_ENV=

# Comma-separated CIDRs of reverse proxies whose X-Forwarded-For header
# the rate limiter may trust (e.g. "10.0.0.0/8"). Leave empty when uvicorn
# is directly exposed — the header is then ignored and the direct peer
# address is used, so clients can't spoof their way past the per-IP limits.
TRUSTED_PROXIES=
